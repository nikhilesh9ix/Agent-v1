# Copy to .env and fill in your key(s).

# Which provider drives chat: "openai" or "groq".
LLM_PROVIDER=openai

# --- OpenAI (chat + embeddings) ---
# https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-key-here

# --- Groq (chat only; OpenAI-compatible, fast, free tier) ---
# https://console.groq.com/keys
GROQ_API_KEY=gsk_your-key-here

# Optional overrides
# LLM_MODEL picks the chat model for the active provider.
#   openai: gpt-4o-mini      groq: llama-3.3-70b-versatile
LLM_MODEL=
OPENAI_EMBED_MODEL=text-embedding-3-small

# NOTE: Groq has no embeddings endpoint. Semantic (vector) memory always uses
# OpenAI embeddings, so it needs OPENAI_API_KEY even when LLM_PROVIDER=groq.
# Episodic (SQLite) memory works with any provider.
