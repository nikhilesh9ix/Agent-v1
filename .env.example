# Copy to .env and fill in your key.

# Which provider drives chat: "openai" or "groq".
LLM_PROVIDER=openai

# --- OpenAI ---
# https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-key-here

# --- Groq (OpenAI-compatible, fast, free tier) ---
# https://console.groq.com/keys
GROQ_API_KEY=gsk_your-key-here

# Optional: pick the chat model for the active provider.
#   openai: gpt-4o-mini      groq: llama-3.3-70b-versatile
LLM_MODEL=
